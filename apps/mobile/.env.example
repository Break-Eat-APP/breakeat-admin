# Application mobile — NOMS des variables uniquement, jamais de valeurs réelles.
#
# Copier en `.env` pour le développement local. Le `.env` est ignoré par Git.
#
# ⚠️ Tout ce qui commence par EXPO_PUBLIC_ est INLINÉ dans le bundle et donc
# lisible par quiconque décompresse l'application. N'y mettez jamais un secret :
# pas de clé Stripe secrète, pas de mot de passe, pas de jeton d'API privé.

# Adresse du backend, terminée par /api/v1.
# Les builds EAS la reçoivent de leur profil (eas.json), pas de ce fichier.
EXPO_PUBLIC_API_URL=

# Clé PUBLIABLE Stripe (pk_test_… en Beta, pk_live_… en production).
# Publiable = conçue pour être exposée côté client. La clé secrète (sk_…) reste
# exclusivement sur le serveur, jamais ici.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Sentry (facultatif) — vide pour désactiver la remontée d'erreurs.
SENTRY_DSN_MOBILE=
