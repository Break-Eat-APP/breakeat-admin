{
  "$schema": "https://schema.expo.dev/eas.schema.json",
  "cli": {
    "version": ">= 12.0.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_ENV": "development"
      }
    },
    "beta": {
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_API_URL": "FILL_IN_STAGING_API_URL"
      },
      "autoIncrement": true
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://breakeat-admin-production.up.railway.app/api/v1"
      }
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://breakeat-admin-production.up.railway.app/api/v1"
      },
      "autoIncrement": true
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "appleId": "reminotta@breakeatapp.com",
        "ascAppId": "6496204412",
        "appleTeamId": "2A5L298Q4C"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "beta"
      }
    },
    "production": {
      "ios": {
        "appleId": "reminotta@breakeatapp.com",
        "ascAppId": "6496204412",
        "appleTeamId": "2A5L298Q4C"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
