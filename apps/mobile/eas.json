{
  "$schema": "https://schema.expo.dev/eas.schema.json",
  "cli": {
    "version": ">= 12.0.0",
    "requireCommit": true,
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "latest"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "APP_ENV": "development",
        "BUNDLE_ID": "com.shapper.breakeat.dev"
      },
      "node": "22.14.0",
      "pnpm": "11.3.0"
    },
    "beta": {
      "distribution": "store",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://breakeat-admin-production.up.railway.app/api/v1"
      },
      "autoIncrement": true,
      "node": "22.14.0",
      "pnpm": "11.3.0"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://breakeat-admin-production.up.railway.app/api/v1",
        "BUNDLE_ID": "com.shapper.breakeat.preview"
      },
      "node": "22.14.0",
      "pnpm": "11.3.0"
    },
    "production": {
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://breakeat-admin-production.up.railway.app/api/v1"
      },
      "autoIncrement": true,
      "node": "22.14.0",
      "ios": {
        "image": "latest"
      },
      "pnpm": "11.3.0"
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "appleId": "reminotta@breakeatapp.com",
        "ascAppId": "6496204412",
        "appleTeamId": "2A5L298Q4C"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "beta"
      }
    },
    "production": {
      "ios": {
        "appleId": "reminotta@breakeatapp.com",
        "ascAppId": "6496204412",
        "appleTeamId": "2A5L298Q4C"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal"
      }
    }
  }
}
