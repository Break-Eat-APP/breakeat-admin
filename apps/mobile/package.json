{
  "name": "@break-eat/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.expo.js",
  "expo": {
    "install": {
      "exclude": [
        "@types/react",
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "preview": "expo start",
    "preview:tunnel": "expo start --tunnel",
    "build:web": "expo export -p web --clear && node scripts/fix-web-assets.cjs",
    "build": "tsc --noEmit",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "clean": "react-native clean"
  },
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo-google-fonts/raleway": "^0.4.2",
    "@expo/metro-runtime": "~57.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.75.0",
    "expo": "~57.0.16",
    "expo-build-properties": "~57.0.14",
    "expo-dev-client": "^57.0.15",
    "expo-font": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "^0.21.2",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@bacons/apple-targets": "5.0.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.0",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "babel-preset-expo": "~57.0.8",
    "eslint": "^9.27.0",
    "jest": "^29.7.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.8.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
