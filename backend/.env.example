# Backend — NOMS des variables uniquement, jamais de valeurs réelles.
#
# Copier en `.env` pour le développement local. Le `.env` est ignoré par Git.
# En production et en staging, les valeurs sont posées dans les variables
# Railway du service correspondant — jamais dans un fichier versionné.

# ─── Base ─────────────────────────────────────────────────────────────────────
NODE_ENV=
# development | staging | production — distingue la Beta de la production.
APP_ENV=
PORT=
# Adresses autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=

# ─── Base de données ──────────────────────────────────────────────────────────
# ⚠️ Le staging DOIT pointer sur une base distincte de la production. C'est la
# seule garantie que les tests n'écrivent pas dans les vraies commandes.
DATABASE_URL=

# ─── Authentification ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# sk_test_… en staging, sk_live_… en production. JAMAIS dans l'app mobile,
# jamais dans Git.
STRIPE_SECRET_KEY=
# Clé PUBLIABLE (pk_test_… / pk_live_…), servie à l'application pour ouvrir la
# feuille de paiement NATIVE. Publique par construction : elle ne peut
# qu'ouvrir un paiement. Sans elle, l'app retombe sur la page hébergée, qui
# sort de l'application le temps du règlement.
STRIPE_PUBLISHABLE_KEY=
# Signature des webhooks (whsec_…). Distincte par environnement : chaque
# endpoint Stripe a la sienne.
# Secret de signature du webhook. Plusieurs valeurs possibles, separees par
# une virgule : Stripe en attribue un PAR point de terminaison, et suivre a la
# fois les paiements et l'etat du compte connecte peut en demander deux.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
# Commission plateforme en points de base (500 = 5 %).
STRIPE_PLATFORM_FEE_BPS=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# ─── Modes d'exploitation ─────────────────────────────────────────────────────
# true expose /demo-checkout, qui crée une commande SANS paiement.
# À laisser vide ou false en production.
DEMO_MODE=
STAGING_ONLY_TOKEN=
# Ouvre la création du compte principal. À RETIRER après usage.
ADMIN_BOOTSTRAP_SECRET=

# ─── Intégration Flaix ────────────────────────────────────────────────────────
FLAIX_API_URL=
FLAIX_API_KEY=
FLAIX_WEBHOOK_SECRET=

# ─── Live Activity iOS (APNs) ─────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Contenu du fichier .p8. Sauts de ligne échappés en \n.
APNS_PRIVATE_KEY=
# sandbox | production
APNS_ENV=

# ─── Divers ───────────────────────────────────────────────────────────────────
REDIS_URL=
SENTRY_DSN_BACKEND=
LOG_LEVEL=

# Adresse publique du site (retour de paiement web, ardoise).
PUBLIC_WEB_URL=

# Adresse publique de CETTE API. Stripe la rappelle au retour du paiement :
# sans elle, le client reste bloque sur la page de paiement, argent debite.
PUBLIC_API_URL=

# ─── Inscriptions rapides (Apple, Google) ─────────────────────────────────────
#
# Ce ne sont PAS des secrets : ce sont les destinataires attendus dans le jeton
# d'identite (claim `aud`). Vide, le fournisseur correspondant n'est pas propose
# dans l'application -- un bouton sans verification derriere vaut moins que pas
# de bouton du tout.
#
# Apple : l'identifiant du paquet iOS. La build `preview` en utilise un autre
# (suffixe .preview) et se presente donc sous ce destinataire-la : les deux
# doivent figurer ici, separes par une virgule, sinon les essais TestFlight
# echouent alors que la production marche.
APPLE_CLIENT_IDS=com.shapper.breakeat,com.shapper.breakeat.preview

# Google : les identifiants clients OAuth de la console Google Cloud,
# separes par une virgule.
#
# METTRE LES DEUX : celui du client « Web » ET celui du client « iOS ».
# Le SDK mobile demande le jeton avec le client Web (c est lui qui fait
# rendre un jeton d IDENTITE), mais selon les versions le destinataire
# inscrit dans le jeton peut etre celui de la plateforme. Les deux dans la
# liste, et la question ne se pose plus.
#
# Vide = le bouton Google est MASQUE dans l app (/auth/providers ne
# l annonce pas). C est voulu : un bouton visible doit etre un bouton qui
# marche.
#
# Un refus ecrit dans le journal le « aud » RECU a cote de ceux attendus :
# c est la que se lit une liste incomplete.
GOOGLE_CLIENT_IDS=

# ─── Stockage de fichiers (NON branché à ce jour) ─────────────────────────────
#
# Prevu pour les images de buvettes et de produits. Tant que ces variables sont
# vides, les images se renseignent par URL. Aucun code ne depend d'elles au
# demarrage.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Partage d'addition entre amis (ardoise). Vide ou false = fonction masquee.
GROUP_SPLIT_ENABLED=

# ── Courriel : « mot de passe oublie » ───────────────────────
#
# TANT QUE CES TROIS LIGNES SONT VIDES, LE PARCOURS N'EXISTE PAS.
# /auth/password-reset/available repond false et l'application n'affiche pas le
# lien « Mot de passe oublie ? ». C'est voulu : promettre « verifie tes
# courriels » sans pouvoir en envoyer est pire que ne rien promettre.
#
# MAIL_PROVIDER : resend | brevo. Les deux s'appellent par un seul POST, donc
# aucune dependance n'a ete ajoutee au projet.
MAIL_PROVIDER=
# La cle d'API du fournisseur. Jamais dans le depot.
MAIL_API_KEY=
# L'expediteur. SON DOMAINE DOIT ETRE VERIFIE chez le fournisseur (SPF/DKIM),
# sinon le message part en indesirable ou ne part pas du tout — et c'est la
# premiere chose a verifier quand le parcours ne marche pas.
MAIL_FROM=
# Ce que le client lit comme nom d'expediteur. Defaut : Break Eat.
MAIL_FROM_NAME=

# Pose par Railway a chaque build, jamais a la main : /health l'affiche pour dire
# QUELLE version repond.
# RAILWAY_GIT_COMMIT_SHA
