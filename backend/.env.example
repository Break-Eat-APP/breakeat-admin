# Backend — NOMS des variables uniquement, jamais de valeurs réelles.
#
# Copier en `.env` pour le développement local. Le `.env` est ignoré par Git.
# En production et en staging, les valeurs sont posées dans les variables
# Railway du service correspondant — jamais dans un fichier versionné.

# ─── Base ─────────────────────────────────────────────────────────────────────
NODE_ENV=
# development | staging | production — distingue la Beta de la production.
APP_ENV=
PORT=
# Adresses autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=

# ─── Base de données ──────────────────────────────────────────────────────────
# ⚠️ Le staging DOIT pointer sur une base distincte de la production. C'est la
# seule garantie que les tests n'écrivent pas dans les vraies commandes.
DATABASE_URL=

# ─── Authentification ─────────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=

# ─── Stripe ───────────────────────────────────────────────────────────────────
# sk_test_… en staging, sk_live_… en production. JAMAIS dans l'app mobile,
# jamais dans Git.
STRIPE_SECRET_KEY=
# Signature des webhooks (whsec_…). Distincte par environnement : chaque
# endpoint Stripe a la sienne.
# Secret de signature du webhook. Plusieurs valeurs possibles, separees par
# une virgule : Stripe en attribue un PAR point de terminaison, et suivre a la
# fois les paiements et l'etat du compte connecte peut en demander deux.
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
# Commission plateforme en points de base (500 = 5 %).
STRIPE_PLATFORM_FEE_BPS=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# ─── Modes d'exploitation ─────────────────────────────────────────────────────
# true expose /demo-checkout, qui crée une commande SANS paiement.
# À laisser vide ou false en production.
DEMO_MODE=
STAGING_ONLY_TOKEN=
# Ouvre la création du compte principal. À RETIRER après usage.
ADMIN_BOOTSTRAP_SECRET=

# ─── Intégration Flaix ────────────────────────────────────────────────────────
FLAIX_API_URL=
FLAIX_API_KEY=
FLAIX_WEBHOOK_SECRET=

# ─── Live Activity iOS (APNs) ─────────────────────────────────────────────────
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Contenu du fichier .p8. Sauts de ligne échappés en \n.
APNS_PRIVATE_KEY=
# sandbox | production
APNS_ENV=

# ─── Divers ───────────────────────────────────────────────────────────────────
REDIS_URL=
SENTRY_DSN_BACKEND=
LOG_LEVEL=

# Adresse publique du site (retour de paiement web, ardoise).
PUBLIC_WEB_URL=

# Adresse publique de CETTE API. Stripe la rappelle au retour du paiement :
# sans elle, le client reste bloque sur la page de paiement, argent debite.
PUBLIC_API_URL=
