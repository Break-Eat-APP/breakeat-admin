{
  "$schema": "https://schema.railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/backend/**",
      "/railway.json",
      "/nixpacks.toml",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/.npmrc"
    ]
  },
  "deploy": {
    "startCommand": "cd backend && pnpm db:generate && sh scripts/migrer.sh && node dist/main",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
